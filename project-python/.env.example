# 应用
APP_NAME=enterprise-ai-agent
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# OpenAI / 兼容 API
OPENAI_API_KEY=sk-your-key
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agent_db

# Redis
REDIS_URL=redis://localhost:6379/0

# 向量库（本地/CI 用 pgvector；生产推荐 pinecone）
VECTOR_STORE=pgvector
EMBEDDING_BACKEND=hash
EMBEDDING_DIM=1536
PINECONE_API_KEY=
PINECONE_INDEX=agent-knowledge
PINECONE_HOST=
RAG_HYBRID_ENABLED=true
RAG_BM25_MAX_DOCS_PER_TENANT=10000
CHAT_STREAM_BUFFER_MAX_CHARS=8000

# Milvus（已弃用主链路，仅遗留代码）
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_COLLECTION_NAME=agent_knowledge

# 日志
LOG_LEVEL=INFO

# 可选：Langfuse 可观测性（见 docs/07-美国NG求职补强/02-可观测性实战.md）
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Epic 3 — 鉴权 / 限流 / 护栏
AUTH_ENABLED=false
API_KEYS=tenant-a:change-me-secret,tenant-b:another-secret
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_AUDIENCE=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=60/minute
CORS_ORIGINS=*
GUARDRAILS_ENABLED=true
MAX_REQUEST_BODY_BYTES=10485760

# Epic 4 — 可观测性与韧性
OTEL_ENABLED=false
OTEL_SERVICE_NAME=enterprise-ai-agent
PROMETHEUS_ENABLED=true
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS_PER_REQUEST=4096
LLM_RETRY_MAX_ATTEMPTS=3
LLM_FALLBACK_MODELS=
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60

# Epic 5 — 生产部署（Docker / K8s）
APP_ENV=development
RUN_MIGRATIONS_ON_STARTUP=true
GUNICORN_WORKERS=2
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_TIMEOUT=120
